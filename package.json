{
  "name": "classroom-planner",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p packages/web --noEmit && tsc -p packages/studio --noEmit",
    "lint": "eslint packages/core/src packages/kernel/src --max-warnings 0",
    "test:unit": "vitest run",
    "test": "npm run lint && npm run typecheck && npm run test:unit",
    "dev:studio": "npm run dev --workspace packages/studio"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}